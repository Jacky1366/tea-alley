APP_NAME="Tea Alley"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://tea-alley.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tea_alley
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payments: "fake" marks orders paid immediately; "stripe" uses Stripe Checkout (test mode).
# Keys go in your local .env only, never here: this repository is public.
PAYMENT_GATEWAY=fake
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (real-time updates). Local-only credentials: any values work as long as the app
# and `php artisan reverb:start` read the same .env. REVERB_HOST/PORT/SCHEME are where
# Laravel sends broadcasts. With REVERB_HOST=tea-alley.test, Reverb finds Herd's
# certificate and serves TLS, so the scheme is https.
REVERB_APP_ID=100001
REVERB_APP_KEY=tea-alley-local-key
REVERB_APP_SECRET=tea-alley-local-secret
REVERB_HOST=tea-alley.test
REVERB_PORT=8080
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Built into the JS. The browser takes the host and scheme from the page itself and only
# the port from here (README, Troubleshooting).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
